---
/**
 * Gallery.astro - responsive masonry-style photo grid with lightbox carousel.
 * Props:
 *   items: Array<{ image, alt? }>
 */
import { Image, getImage } from 'astro:assets';

const { items = [] } = Astro.props;

const galleryItems = await Promise.all(
  items.map(async (item) => {
    const lightboxImage = await getImage({
      src: item.image,
      width: 1800,
      format: 'webp',
      quality: 84,
    });

    return {
      ...item,
      lightboxSrc: lightboxImage.src,
    };
  }),
);
---

<div class="gallery" data-gallery>
  {galleryItems.map((item, index) => (
    <figure class="gallery__item">
      <button
        class="gallery__button"
        type="button"
        data-gallery-trigger
        data-gallery-index={index}
        data-gallery-src={item.lightboxSrc}
        data-gallery-alt={item.alt ?? ''}
        aria-label={`Open photo ${index + 1} of ${galleryItems.length}`}
      >
        <Image
          src={item.image}
          alt={item.alt ?? ''}
          widths={[240, 400, 700, 1000]}
          sizes="(max-width: 500px) 50vw, (max-width: 900px) 50vw, 33vw"
          loading="lazy"
          decoding="async"
        />
      </button>
    </figure>
  ))}
</div>

<div class="gallery-lightbox" data-gallery-lightbox aria-hidden="true">
  <div class="gallery-lightbox__backdrop" data-gallery-close></div>
  <div class="gallery-lightbox__dialog" role="dialog" aria-modal="true" aria-label="Photo carousel">
    <button class="gallery-lightbox__close" type="button" data-gallery-close aria-label="Close photo carousel">×</button>
    <button class="gallery-lightbox__nav gallery-lightbox__nav--prev" type="button" data-gallery-prev aria-label="Previous photo">‹</button>
    <img class="gallery-lightbox__image" data-gallery-image src="data:image/gif;base64,R0lGODlhAQABAAAAACw=" alt="" draggable="false" />
    <button class="gallery-lightbox__nav gallery-lightbox__nav--next" type="button" data-gallery-next aria-label="Next photo">›</button>
    <div class="gallery-lightbox__status">
      <p class="gallery-lightbox__counter" data-gallery-counter aria-live="polite"></p>
      <button class="gallery-lightbox__autoplay" type="button" data-gallery-autoplay aria-pressed="false">Pause autoplay</button>
    </div>
  </div>
</div>

<script>
  const AUTOPLAY_MS = 5000;
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll('[data-gallery]').forEach((gallery) => {
    const lightbox = gallery.nextElementSibling;
    if (!lightbox?.matches('[data-gallery-lightbox]')) return;

    const triggers = Array.from(gallery.querySelectorAll('[data-gallery-trigger]'));
    const image = lightbox.querySelector('[data-gallery-image]');
    const counter = lightbox.querySelector('[data-gallery-counter]');
    const autoplayButton = lightbox.querySelector('[data-gallery-autoplay]');
    const closeButtons = lightbox.querySelectorAll('[data-gallery-close]');
    const prevButton = lightbox.querySelector('[data-gallery-prev]');
    const nextButton = lightbox.querySelector('[data-gallery-next]');

    let currentIndex = 0;
    let autoplayId = null;
    let isAutoplayPaused = prefersReducedMotion;
    let lastFocused = null;
    let touchStartX = 0;
    let touchStartY = 0;

    const stopAutoplay = () => {
      if (autoplayId) {
        window.clearInterval(autoplayId);
        autoplayId = null;
      }
    };

    const updateAutoplayButton = () => {
      if (!autoplayButton) return;
      autoplayButton.textContent = isAutoplayPaused ? 'Resume autoplay' : 'Pause autoplay';
      autoplayButton.setAttribute('aria-pressed', String(isAutoplayPaused));
    };

    const startAutoplay = () => {
      stopAutoplay();
      if (!isAutoplayPaused && triggers.length > 1) {
        autoplayId = window.setInterval(() => showPhoto(currentIndex + 1), AUTOPLAY_MS);
      }
      updateAutoplayButton();
    };

    const toggleAutoplay = () => {
      isAutoplayPaused = !isAutoplayPaused;
      startAutoplay();
    };

    const normalizeIndex = (index) => (index + triggers.length) % triggers.length;

    function showPhoto(index) {
      if (!triggers.length) return;
      currentIndex = normalizeIndex(index);
      const trigger = triggers[currentIndex];
      image.src = trigger.dataset.gallerySrc;
      image.alt = trigger.dataset.galleryAlt || '';
      counter.textContent = `${currentIndex + 1} / ${triggers.length}`;
    }

    const openLightbox = (index) => {
      lastFocused = document.activeElement;
      isAutoplayPaused = prefersReducedMotion;
      showPhoto(index);
      lightbox.setAttribute('aria-hidden', 'false');
      document.documentElement.classList.add('gallery-lightbox-open');
      nextButton?.focus();
      startAutoplay();
    };

    const closeLightbox = () => {
      stopAutoplay();
      lightbox.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.remove('gallery-lightbox-open');
      image.removeAttribute('src');
      if (lastFocused instanceof HTMLElement) lastFocused.focus();
    };

    const navigate = (direction) => {
      showPhoto(currentIndex + direction);
      startAutoplay();
    };

    const isOpen = () => lightbox.getAttribute('aria-hidden') !== 'true';

    const handleTouchStart = (event) => {
      if (!isOpen()) return;
      const touch = event.changedTouches[0];
      touchStartX = touch.clientX;
      touchStartY = touch.clientY;
    };

    const handleTouchEnd = (event) => {
      if (!isOpen()) return;
      const touch = event.changedTouches[0];
      const deltaX = touch.clientX - touchStartX;
      const deltaY = touch.clientY - touchStartY;
      if (Math.abs(deltaX) < 50 || Math.abs(deltaX) < Math.abs(deltaY) * 1.4) return;
      navigate(deltaX < 0 ? 1 : -1);
    };

    const handleVisibilityChange = () => {
      if (!isOpen()) return;
      if (document.hidden) {
        stopAutoplay();
      } else {
        startAutoplay();
      }
    };

    triggers.forEach((trigger, index) => {
      trigger.addEventListener('click', () => openLightbox(index));
    });

    closeButtons.forEach((button) => button.addEventListener('click', closeLightbox));
    prevButton?.addEventListener('click', () => navigate(-1));
    nextButton?.addEventListener('click', () => navigate(1));
    autoplayButton?.addEventListener('click', toggleAutoplay);
    lightbox.addEventListener('touchstart', handleTouchStart, { passive: true });
    lightbox.addEventListener('touchend', handleTouchEnd, { passive: true });
    document.addEventListener('visibilitychange', handleVisibilityChange);

    document.addEventListener('keydown', (event) => {
      if (lightbox.getAttribute('aria-hidden') === 'true') return;

      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        navigate(-1);
      }

      if (event.key === 'ArrowRight') {
        event.preventDefault();
        navigate(1);
      }

      if (event.key === 'Escape') {
        event.preventDefault();
        closeLightbox();
      }
    });
  });
</script>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(0.5rem, 2vw, var(--space-3));
  }
  @media (max-width: 900px) {
    .gallery { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 340px) {
    .gallery { grid-template-columns: 1fr; }
  }

  .gallery__item {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--color-bg-alt);
  }

  .gallery__button {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    border-radius: inherit;
    color: inherit;
    background: transparent;
    cursor: zoom-in;
    touch-action: manipulation;
  }

  .gallery__button:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  .gallery__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }
  .gallery__item:hover :global(img),
  .gallery__button:focus-visible :global(img) {
    transform: scale(1.05);
  }

  .gallery-lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    padding: max(0.75rem, env(safe-area-inset-top)) max(0.75rem, env(safe-area-inset-right)) max(0.75rem, env(safe-area-inset-bottom)) max(0.75rem, env(safe-area-inset-left));
    opacity: 0;
    pointer-events: none;
    overscroll-behavior: contain;
    touch-action: pan-y;
    transition: opacity var(--transition-base);
  }

  .gallery-lightbox[aria-hidden='false'] {
    opacity: 1;
    pointer-events: auto;
  }

  .gallery-lightbox__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.88);
  }

  .gallery-lightbox__dialog {
    position: relative;
    display: grid;
    place-items: center;
    width: min(100%, 1180px);
    height: min(100%, 100dvh);
    max-height: calc(100dvh - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  }

  .gallery-lightbox__image {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: calc(100dvh - 7.5rem - env(safe-area-inset-top) - env(safe-area-inset-bottom));
    object-fit: contain;
    border-radius: var(--radius-sm);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.45);
    background: rgba(255, 255, 255, 0.06);
  }

  .gallery-lightbox__close,
  .gallery-lightbox__nav {
    position: absolute;
    display: grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    border: 0;
    color: #fff;
    background: rgba(0, 0, 0, 0.55);
    cursor: pointer;
    transition: background var(--transition-base), transform var(--transition-base);
  }

  .gallery-lightbox__close:hover,
  .gallery-lightbox__nav:hover,
  .gallery-lightbox__close:focus-visible,
  .gallery-lightbox__nav:focus-visible {
    background: rgba(0, 0, 0, 0.82);
    transform: scale(1.04);
  }

  .gallery-lightbox__close {
    top: max(0.5rem, env(safe-area-inset-top));
    right: max(0.5rem, env(safe-area-inset-right));
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    font-size: 2rem;
    line-height: 1;
  }

  .gallery-lightbox__nav {
    top: 50%;
    width: clamp(3rem, 11vw, 4.5rem);
    height: clamp(3rem, 11vw, 4.5rem);
    border-radius: 999px;
    font-size: clamp(2.4rem, 7vw, 4.5rem);
    line-height: 1;
    transform: translateY(-50%);
  }

  .gallery-lightbox__nav:hover,
  .gallery-lightbox__nav:focus-visible {
    transform: translateY(-50%) scale(1.04);
  }

  .gallery-lightbox__nav--prev {
    left: max(0.5rem, env(safe-area-inset-left));
  }

  .gallery-lightbox__nav--next {
    right: max(0.5rem, env(safe-area-inset-right));
  }

  .gallery-lightbox__status {
    position: absolute;
    bottom: max(0.5rem, env(safe-area-inset-bottom));
    left: 50%;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transform: translateX(-50%);
  }

  .gallery-lightbox__counter,
  .gallery-lightbox__autoplay {
    margin: 0;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    color: #fff;
    background: rgba(0, 0, 0, 0.6);
  }

  .gallery-lightbox__autoplay {
    border: 0;
    font: inherit;
    white-space: nowrap;
    cursor: pointer;
    transition: background var(--transition-base), transform var(--transition-base);
  }

  .gallery-lightbox__autoplay:hover,
  .gallery-lightbox__autoplay:focus-visible {
    background: rgba(0, 0, 0, 0.82);
    transform: scale(1.04);
  }

  :global(.gallery-lightbox-open) {
    overflow: hidden;
  }

  @media (hover: none) {
    .gallery__item:hover :global(img),
    .gallery__button:focus-visible :global(img) {
      transform: none;
    }

    .gallery-lightbox__nav {
      background: rgba(0, 0, 0, 0.68);
    }
  }

  @media (max-width: 700px) {
    .gallery-lightbox__dialog {
      width: 100%;
      height: 100dvh;
    }

    .gallery-lightbox__image {
      max-height: calc(100dvh - 8.5rem - env(safe-area-inset-top) - env(safe-area-inset-bottom));
      max-width: calc(100vw - 1.5rem - env(safe-area-inset-left) - env(safe-area-inset-right));
    }

    .gallery-lightbox__status {
      width: min(100%, 22rem);
      justify-content: center;
      flex-wrap: wrap;
    }

    .gallery-lightbox__counter,
    .gallery-lightbox__autoplay {
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
  }
</style>
