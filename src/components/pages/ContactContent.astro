const email = 'mail@skydive.lu';
const phone = '+352 621 701 194 (SMS or WhatsApp only; phone calls by appointment)';
const phoneHref = 'tel:+352621701194';
---

<PageBanner
  image={bannerImg}
  alt="Skydive Luxembourg dropzone office"
  imagePosition="center 36%"
  eyebrow={t.eyebrow}
  title={t.title}
  subtitle={t.subtitle}
/>

<section class="section">
  <div class="section__inner">
    <div class="grid grid--2 contact-grid">
      <div class="contact-info">
        <p class="section__eyebrow">{t.infoEyebrow}</p>
        <h2 class="section__title">{t.infoTitle}</h2>
        <p class="section__lead">{t.infoIntro}</p>

        <dl class="contact-info__list">
          <dt>{t.addressLabel}</dt>
          <dd>
            {t.addressLines.map((line, i) => (
              <>{line}{i < t.addressLines.length - 1 && <br />}</>
            ))}
          </dd>

          <dt>{t.emailLabel}</dt>
          <dd><a href={`mailto:${email}`}>{email}</a></dd>

          <dt>{t.phoneLabel}</dt>
          <dd><a href={phoneHref}>{phone}</a></dd>

          <dt>{t.hoursLabel}</dt>
          <dd>
            {t.hoursLines.map((line, i) => (
              <>{line}{i < t.hoursLines.length - 1 && <br />}</>
            ))}
            <br /><small>{t.hoursNote}</small>
          </dd>
        </dl>
      </div>

      <div class="contact-form-wrap">
        <p class="section__eyebrow">{t.formEyebrow}</p>
        <h2 class="section__title">{t.formTitle}</h2>
        <p class="section__lead">{t.formLead}</p>
        <ContactForm lang={lang} />
      </div>
    </div>
  </div>
</section>

<section class="section section--alt section--tight">
  <div class="section__inner">
    <h2 class="section__title">{t.directionsTitle}</h2>
    <p class="section__lead">{t.directionsText}</p>
    <div
      class="contact-map contact-map--placeholder"
      data-map-placeholder
      data-map-title={t.mapTitle}
      data-map-src="https://www.google.com/maps?q=A%C3%A9rodrome+de+Noertrange,+Luxembourg&output=embed"
    >
      <p>{t.mapPrivacyNotice}</p>
      <div class="contact-map__actions">
        <a
          class="btn btn--secondary"
          href="https://www.google.com/maps?q=A%C3%A9rodrome+de+Noertrange,+Luxembourg"
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.openMap}
        </a>
        <button class="btn btn--primary" type="button" data-load-map>{t.loadMap}</button>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('[data-map-placeholder]').forEach((placeholder) => {
    const button = placeholder.querySelector('[data-load-map]');
    if (!(button instanceof HTMLButtonElement)) return;

    button.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.title = placeholder.getAttribute('data-map-title') || 'Map';
      iframe.src = placeholder.getAttribute('data-map-src') || '';
      iframe.width = '100%';
      iframe.height = '420';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer';
      iframe.allowFullscreen = true;
      iframe.style.border = '0';

      placeholder.classList.remove('contact-map--placeholder');
      placeholder.replaceChildren(iframe);
    });
  });
</script>

<style>
  .contact-grid {
    gap: var(--space-10);
    align-items: start;
  }

  .contact-info__list {
    margin-top: var(--space-6);
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-3) var(--space-6);
  }
  .contact-info__list dt {
    font-weight: var(--fw-medium);
    color: var(--color-fg);
  }
  .contact-info__list dd {
    margin: 0;
    color: var(--color-fg-muted);
  }
  .contact-info__list a {
    color: var(--color-blue);
    text-decoration: none;
  }
  .contact-info__list a:hover {
    text-decoration: underline;
  }

  .contact-map {
    margin-top: var(--space-6);
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }
  .contact-map--placeholder {
    padding: var(--space-6);
    background: var(--color-bg);
  }
  .contact-map__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  .contact-map__actions .btn {
    width: auto;
  }
</style>
