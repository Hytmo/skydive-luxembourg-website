const email = 'mail@skydive.lu';
const phone = '+352 621 701 194';
const phoneNote = {
  en: 'SMS or WhatsApp only; phone calls by appointment.',
  fr: 'SMS ou WhatsApp uniquement ; appels téléphoniques sur rendez-vous.',
  de: 'Nur SMS oder WhatsApp; Telefonanrufe nach Vereinbarung.',
  lu: 'Nur SMS oder WhatsApp; Telefonanrufe nach Vereinbarung.',
}[lang];
const whatsappLabel = {
  en: 'Message us on WhatsApp',
  fr: 'Écrire sur WhatsApp',
  de: 'Per WhatsApp schreiben',
  lu: 'Iwwer WhatsApp schreiwen',
}[lang];
const whatsappText = {
  en: 'Hello Skydive Luxembourg!',
  fr: 'Bonjour Skydive Luxembourg !',
  de: 'Hallo Skydive Luxembourg!',
  lu: 'Moien Skydive Luxembourg!',
}[lang];
const whatsappHref = `https://wa.me/352621701194?text=${encodeURIComponent(whatsappText)}`;
---

<PageBanner
  image={bannerImg}
  alt="Skydive Luxembourg dropzone office"
  imagePosition="center 36%"
  eyebrow={t.eyebrow}
  title={t.title}
  subtitle={t.subtitle}
/>

<section class="section">
  <div class="section__inner">
    <div class="grid grid--2 contact-grid">
      <div class="contact-info">
        <p class="section__eyebrow">{t.infoEyebrow}</p>
        <h2 class="section__title">{t.infoTitle}</h2>
        <p class="section__lead">{t.infoIntro}</p>

        <dl class="contact-info__list">
          <dt>{t.addressLabel}</dt>
          <dd>
            {t.addressLines.map((line, i) => (
              <>{line}{i < t.addressLines.length - 1 && <br />}</>
            ))}
          </dd>

          <dt>{t.emailLabel}</dt>
          <dd><a href={`mailto:${email}`}>{email}</a></dd>

          <dt>{t.phoneLabel}</dt>
          <dd>
            {phone}<br />
            <small>{phoneNote}</small><br />
            <a
              class="btn btn--secondary"
              style="margin-top: var(--space-2)"
              href={whatsappHref}
              target="_blank"
              rel="noopener noreferrer"
            >
              {whatsappLabel}
            </a>
          </dd>

          <dt>{t.hoursLabel}</dt>
          <dd>
            {t.hoursLines.map((line, i) => (
              <>{line}{i < t.hoursLines.length - 1 && <br />}</>
            ))}
            <br /><small>{t.hoursNote}</small>
          </dd>
        </dl>
      </div>

      <div class="contact-form-wrap">
        <p class="section__eyebrow">{t.formEyebrow}</p>
        <h2 class="section__title">{t.formTitle}</h2>
        <p class="section__lead">{t.formLead}</p>
        <ContactForm lang={lang} />
      </div>
    </div>
  </div>
</section>

<section class="section section--alt section--tight">
  <div class="section__inner">
    <h2 class="section__title">{t.directionsTitle}</h2>
    <p class="section__lead">{t.directionsText}</p>
    <div class="contact-map">
      <iframe
        class="contact-map__frame"
        title={t.mapTitle}
        src="https://www.google.com/maps?q=A%C3%A9rodrome+de+Noertrange,+Luxembourg&output=embed"
        width="100%"
        height="420"
        loading="lazy"
        referrerpolicy="no-referrer"
        allowfullscreen
      ></iframe>
    </div>
    <p class="contact-map__note">
      {t.mapPrivacyNotice}
      <a
        class="contact-map__link"
        href="https://www.google.com/maps?q=A%C3%A9rodrome+de+Noertrange,+Luxembourg"
        target="_blank"
        rel="noopener noreferrer nofollow"
      >{t.openMap}</a>
    </p>
  </div>
</section>

<style>
  .contact-grid {
    gap: var(--space-10);
    align-items: start;
  }

  .contact-info__list {
    margin-top: var(--space-6);
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-3) var(--space-6);
  }
  .contact-info__list dt {
    font-weight: var(--fw-medium);
    color: var(--color-fg);
  }
  .contact-info__list dd {
    margin: 0;
    color: var(--color-fg-muted);
  }
  /* Plain links in the list (e.g. the email) get the blue link colour.
     Exclude .btn so a button placed here (WhatsApp) keeps its own white
     text — otherwise this more-specific rule paints blue-on-blue. */
  .contact-info__list a:not(.btn) {
    color: var(--color-blue);
    text-decoration: none;
  }
  .contact-info__list a:not(.btn):hover {
    text-decoration: underline;
  }

  .contact-map {
    margin-top: var(--space-6);
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }
  .contact-map__frame {
    display: block;
    width: 100%;
    height: 420px;
    border: 0;
  }
  @media (max-width: 700px) {
    .contact-map__frame { height: 320px; }
  }
  .contact-map__note {
    margin-top: var(--space-3);
    font-size: var(--fs-sm);
    color: var(--color-fg-muted);
  }
  .contact-map__link { margin-left: var(--space-1); }
</style>
