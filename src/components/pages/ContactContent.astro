    mapTitle: 'Carte de l\'aérodrome de Noertrange',
    mapPrivacyNotice: 'La carte est fournie par Google Maps. Son chargement peut transférer des données à Google.',
    loadMap: 'Charger la carte Google',
    openMap: 'Ouvrir dans Google Maps',
  },

  de: {
    eyebrow: 'Kontakt',
    title: 'Kontakt aufnehmen',
    subtitle: 'Fragen, Buchungen, Gruppenanfragen - wir lesen jede Nachricht.',
    infoEyebrow: 'So findest du uns',
