---
/**
 * GalleryContent.astro - gallery page body. Picks copy by `lang` prop.
 */
import PageBanner from '../sections/PageBanner.astro';
import Gallery from '../sections/Gallery.astro';

import bannerImg from '../../assets/img/Gallery-7.jpg';

const { lang = 'en' } = Astro.props;

const t = {
  en: {
    bannerEyebrow: 'Gallery',
    bannerTitle: 'A few thousand feet from here.',
    bannerSubtitle: 'Moments from the dropzone, the aircraft, and the sky above Luxembourg.',
    introText: 'Photos and stills captured by our jumpers, instructors and camera flyers across the seasons. Want to see your shot here? Send it over - we love sharing the club\'s view of the world.',
    categories: {
      action: { title: 'Skydiving action', lead: 'Freefall, exits and canopy moments from the Luxembourg sky.' },
      tandem: { title: 'Tandem skydives', lead: 'First-jump moments with our tandem instructors.' },
      aff: { title: 'AFF training', lead: 'Student training moments from the path to solo skydiving.' },
    },
  },
  fr: {
    bannerEyebrow: 'Galerie',
    bannerTitle: 'À quelques milliers de pieds d\'ici.',
    bannerSubtitle: 'Instants captés sur la DZ, dans l\'avion et dans le ciel du Luxembourg.',
    introText: 'Photos et captures prises par nos parachutistes, moniteurs et caméramen au fil des saisons. Vous voulez voir votre cliché ici ? Envoyez-le - nous aimons partager le regard du club sur le monde.',
    categories: {
      action: { title: 'Action parachutisme', lead: 'Chute libre, sorties d\'avion et voiles dans le ciel luxembourgeois.' },
      tandem: { title: 'Sauts tandem', lead: 'Premiers sauts accompagnés par nos moniteurs tandem.' },
      aff: { title: 'Formation AFF', lead: 'Moments de formation sur le chemin vers le saut solo.' },
    },
  },
  de: {
    bannerEyebrow: 'Galerie',
    bannerTitle: 'Ein paar tausend Fuß von hier entfernt.',
    bannerSubtitle: 'Momente vom Flugplatz, aus dem Flugzeug und vom Himmel über Luxemburg.',
    introText: 'Fotos und Standbilder unserer Springer, Lehrer und Kameraflieger aus allen Jahreszeiten. Willst du dein Bild hier sehen? Schick es uns - wir teilen den Blick des Vereins gerne.',
    categories: {
      action: { title: 'Fallschirm-Action', lead: 'Freifall, Ausstiege und Schirmflug über Luxemburg.' },
      tandem: { title: 'Tandemsprünge', lead: 'Erste Sprungmomente mit unseren Tandemlehrern.' },
      aff: { title: 'AFF-Ausbildung', lead: 'Ausbildungsmomente auf dem Weg zum Solo-Fallschirmspringen.' },
    },
  },
}[lang];

const actionImages = Object.entries(import.meta.glob('../../assets/img/website-selection/action/*.{jpg,jpeg,png,webp}', { eager: true, import: 'default' }))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, image]) => ({ image, alt: t.categories.action.title }));
const tandemImages = Object.entries(import.meta.glob('../../assets/img/website-selection/tandem/*.{jpg,jpeg,png,webp}', { eager: true, import: 'default' }))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, image]) => ({ image, alt: t.categories.tandem.title }));
const affImages = Object.entries(import.meta.glob('../../assets/img/website-selection/aff/*.{jpg,jpeg,png,webp}', { eager: true, import: 'default' }))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, image]) => ({ image, alt: t.categories.aff.title }));

const galleries = [
  { key: 'action', copy: t.categories.action, items: actionImages },
  { key: 'tandem', copy: t.categories.tandem, items: tandemImages },
  { key: 'aff', copy: t.categories.aff, items: affImages },
].filter((category) => category.items.length > 0);
---

<PageBanner
  image={bannerImg}
  alt="Skydiving above Luxembourg"
  eyebrow={t.bannerEyebrow}
  title={t.bannerTitle}
  subtitle={t.bannerSubtitle}
/>

<section class="section gallery-page">
  <div class="section__inner">
    <header class="section__header">
      <p class="section__lead">{t.introText}</p>
    </header>

    <div class="gallery-categories">
      {galleries.map((category) => (
        <section class="gallery-category" aria-labelledby={`gallery-${category.key}`}>
          <header class="gallery-category__header">
            <h2 id={`gallery-${category.key}`}>{category.copy.title}</h2>
            <p>{category.copy.lead}</p>
          </header>
          <Gallery items={category.items} />
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery-categories {
    display: grid;
    gap: var(--space-6);
  }

  .gallery-category {
    display: grid;
    gap: var(--space-3);
  }

  .gallery-category__header {
    max-width: 720px;
  }

  .gallery-category__header h2 {
    margin: 0 0 var(--space-1);
    font-size: clamp(1.6rem, 2vw, 2.35rem);
  }

  .gallery-category__header p {
    margin: 0;
    color: var(--color-text-muted);
  }
</style>
