---
/**
 * GalleryContent.astro - gallery page body. Picks copy by `lang` prop.
 */
import PageBanner from '../sections/PageBanner.astro';
import Gallery from '../sections/Gallery.astro';

import bannerImg from '../../assets/img/Gallery-7.webp';

const { lang = 'en' } = Astro.props;

const t = {
  en: {
    bannerEyebrow: 'Gallery',
    bannerTitle: 'A few thousand feet from here.',
    bannerSubtitle: 'Moments from the dropzone, the aircraft, and the sky above Luxembourg.',
    introText: 'Photos and stills captured by our jumpers, instructors and camera flyers across the seasons. Want to see your shot here? Send it over - we love sharing the club\'s view of the world.',
    categoryNavLabel: 'Gallery sections',
    categories: {
      action: { title: 'Skydiving action', lead: 'Freefall, exits and canopy moments from the Luxembourg sky.' },
      tandem: { title: 'Tandem skydives', lead: 'First-jump moments with our tandem instructors.' },
      aff: { title: 'AFF training', lead: 'Student training moments from the path to solo skydiving.' },
      dropzone: { title: 'Dropzone life', lead: 'People, aircraft, packing, events and everyday club moments at Noertrange.' },
      aircraft: { title: 'Aircraft', lead: 'Our jump aircraft and airfield scenes.' },
      historical: { title: 'Club history', lead: 'Archive moments from Cercle Para to Skydive Luxembourg, ordered from newer colour photos to the oldest black-and-white images.' },
    },
  },
  fr: {
    bannerEyebrow: 'Galerie',
    bannerTitle: 'À quelques milliers de pieds d\'ici.',
    bannerSubtitle: 'Instants captés sur la DZ, dans l\'avion et dans le ciel du Luxembourg.',
    introText: 'Photos et captures prises par nos parachutistes, moniteurs et caméramen au fil des saisons. Vous voulez voir votre cliché ici ? Envoyez-le - nous aimons partager le regard du club sur le monde.',
    categoryNavLabel: 'Sections de la galerie',
    categories: {
      action: { title: 'Action parachutisme', lead: 'Chute libre, sorties d\'avion et voiles dans le ciel luxembourgeois.' },
      tandem: { title: 'Sauts tandem', lead: 'Premiers sauts accompagnés par nos moniteurs tandem.' },
      aff: { title: 'Formation AFF', lead: 'Moments de formation sur le chemin vers le saut solo.' },
      dropzone: { title: 'Vie de la dropzone', lead: 'Personnes, avions, pliage, événements et moments de club à Noertrange.' },
      aircraft: { title: 'Avions', lead: 'Nos avions de largage et scènes d\'aérodrome.' },
      historical: { title: 'Histoire du club', lead: 'Archives du Cercle Para à Skydive Luxembourg, des photos couleur les plus récentes aux plus anciennes en noir et blanc.' },
    },
  },
  de: {
    bannerEyebrow: 'Galerie',
    bannerTitle: 'Ein paar tausend Fuß von hier entfernt.',
    bannerSubtitle: 'Momente vom Flugplatz, aus dem Flugzeug und vom Himmel über Luxemburg.',
    introText: 'Fotos und Standbilder unserer Springer, Lehrer und Kameraflieger aus allen Jahreszeiten. Willst du dein Bild hier sehen? Schick es uns - wir teilen den Blick des Vereins gerne.',
    categoryNavLabel: 'Galerie-Bereiche',
    categories: {
      action: { title: 'Fallschirm-Action', lead: 'Freifall, Ausstiege und Schirmflug über Luxemburg.' },
      tandem: { title: 'Tandemsprünge', lead: 'Erste Sprungmomente mit unseren Tandemlehrern.' },
      aff: { title: 'AFF-Ausbildung', lead: 'Ausbildungsmomente auf dem Weg zum Solo-Fallschirmspringen.' },
      dropzone: { title: 'Leben auf der Dropzone', lead: 'Menschen, Flugzeuge, Packen, Events und Clubmomente in Noertrange.' },
      aircraft: { title: 'Flugzeuge', lead: 'Unsere Absetzflugzeuge und Szenen vom Flugplatz.' },
      historical: { title: 'Clubgeschichte', lead: 'Archivmomente vom Cercle Para bis Skydive Luxembourg, von neueren Farbfotos bis zu den ältesten Schwarz-Weiß-Bildern.' },
    },
  },
}[lang];

const actionImages = Object.entries(import.meta.glob('../../assets/img/website-selection/action/*.{jpg,jpeg,png,webp}', { eager: true, import: 'default' }))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, image]) => ({ image, alt: t.categories.action.title }));
const tandemImages = Object.entries(import.meta.glob('../../assets/img/website-selection/tandem/*.{jpg,jpeg,png,webp}', { eager: true, import: 'default' }))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, image]) => ({ image, alt: t.categories.tandem.title }));
const affImages = Object.entries(import.meta.glob('../../assets/img/website-selection/aff/*.{jpg,jpeg,png,webp}', { eager: true, import: 'default' }))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, image]) => ({ image, alt: t.categories.aff.title }));
const dropzoneImages = Object.entries(import.meta.glob('../../assets/img/website-selection/dropzone/*.{jpg,jpeg,png,webp}', { eager: true, import: 'default' }))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, image]) => ({ image, alt: t.categories.dropzone.title }));
const aircraftImages = Object.entries(import.meta.glob('../../assets/img/website-selection/aircraft/*.{jpg,jpeg,png,webp}', { eager: true, import: 'default' }))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, image]) => ({ image, alt: t.categories.aircraft.title }));
const historicalImages = Object.entries(import.meta.glob('../../assets/img/website-selection/historical/*.{jpg,jpeg,png,webp}', { eager: true, import: 'default' }))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, image]) => ({ image, alt: t.categories.historical.title }));

const galleries = [
  { key: 'action', copy: t.categories.action, items: actionImages },
  { key: 'tandem', copy: t.categories.tandem, items: tandemImages },
  { key: 'aff', copy: t.categories.aff, items: affImages },
  { key: 'dropzone', copy: t.categories.dropzone, items: dropzoneImages },
  { key: 'aircraft', copy: t.categories.aircraft, items: aircraftImages },
  { key: 'historical', copy: t.categories.historical, items: historicalImages },
].filter((category) => category.items.length > 0);
---

<PageBanner
  image={bannerImg}
  alt="Skydiving above Luxembourg"
  eyebrow={t.bannerEyebrow}
  title={t.bannerTitle}
  subtitle={t.bannerSubtitle}
/>

<section class="section gallery-page">
  <div class="section__inner">
    <header class="section__header">
      <p class="section__lead">{t.introText}</p>
    </header>

    <nav class="gallery-jump-nav" aria-label={t.categoryNavLabel}>
      {galleries.map((category) => (
        <a href={`#gallery-${category.key}`} class="gallery-jump-nav__link">{category.copy.title}</a>
      ))}
    </nav>

    <div class="gallery-categories">
      {galleries.map((category) => (
        <section class="gallery-category" aria-labelledby={`gallery-${category.key}`}>
          <header class="gallery-category__header">
            <h2 id={`gallery-${category.key}`}>{category.copy.title}</h2>
            <p>{category.copy.lead}</p>
          </header>
          <Gallery items={category.items} />
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery-jump-nav {
    position: sticky;
    top: var(--site-nav-height, 76px);
    z-index: 5;
    display: flex;
    gap: var(--space-2);
    margin: calc(var(--space-6) * -1) calc(var(--space-4) * -1) var(--space-8);
    padding: var(--space-3) max(var(--space-4), env(safe-area-inset-right)) var(--space-3) max(var(--space-4), env(safe-area-inset-left));
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    background: var(--color-bg);
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(10px);
    -webkit-overflow-scrolling: touch;
  }

  .gallery-jump-nav::-webkit-scrollbar {
    display: none;
  }

  .gallery-jump-nav__link {
    flex: 0 0 auto;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-fg);
    background: var(--color-bg-alt);
    font-weight: var(--fw-medium);
    text-decoration: none;
    white-space: nowrap;
  }

  .gallery-jump-nav__link:hover,
  .gallery-jump-nav__link:focus-visible {
    color: var(--color-bg);
    background: var(--color-blue);
    border-color: var(--color-blue);
  }

  .gallery-categories {
    display: grid;
    gap: var(--space-8);
  }

  .gallery-category {
    display: grid;
    gap: var(--space-3);
  }

  .gallery-category__header {
    max-width: 720px;
  }

  .gallery-category__header h2 {
    margin: 0 0 var(--space-1);
    font-size: clamp(1.6rem, 2vw, 2.35rem);
  }

  .gallery-category__header p {
    margin: 0;
    color: var(--color-text-muted);
  }
</style>
