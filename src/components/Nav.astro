---
/**
 * Nav.astro - main site navigation.
 * Self-contained: translations, styles, mobile toggle, language switcher.
 * Used inside Layout.astro.
 *
 * NOTE: "Find us" page was merged into "Contact" - location info and the
 *       contact form now live on the same page.
 */

import { Image } from 'astro:assets';

import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

import logoBlack from '../assets/logo/skydive-logo-black.png';
import logoWhite from '../assets/logo/skydive-logo-white.png';

const lang = Astro.currentLocale ?? 'en';
const path = Astro.url.pathname;

// "Book a tandem" lands on the tandem page's booking section, which offers
// the three dz-cloud options (buy with a date, gift card, redeem a gift card).
const bookHref = `/${lang}/tandem#book`;

const labels = {
  en: {
    about: 'About', tandem: 'Tandem', aff: 'AFF',
    funJumpers: 'Fun jumpers', pricing: 'Pricing',
    gallery: 'Gallery', faq: 'FAQ', contact: 'Contact',
    menu: 'Menu',
    book: 'Book a tandem', bookShort: 'Book',
  },
  fr: {
    about: 'À propos', tandem: 'Tandem', aff: 'AFF',
    funJumpers: 'Parachutistes confirmés', pricing: 'Tarifs',
    gallery: 'Galerie', faq: 'FAQ', contact: 'Contact',
    menu: 'Menu',
    book: 'Réserver un tandem', bookShort: 'Réserver',
  },
  de: {
    about: 'Über uns', tandem: 'Tandem', aff: 'AFF',
    funJumpers: 'Sportspringer', pricing: 'Preise',
    gallery: 'Galerie', faq: 'FAQ', contact: 'Kontakt',
    menu: 'Menü',
    book: 'Tandem buchen', bookShort: 'Buchen',
  },

  lu: {
    about: 'Iwwer eis', tandem: 'Tandem', aff: 'AFF',
    funJumpers: 'Sportsprénger', pricing: 'Präisser',
    gallery: 'Galerie', faq: 'FAQ', contact: 'Kontakt',
    menu: 'Menü',
    book: 'Tandem buchen', bookShort: 'Buchen',
  },
};

const t = labels[lang] ?? labels.en;

const items = [
  ['about',       t.about],
  ['tandem',      t.tandem],
  ['aff',         t.aff],
  ['fun-jumpers', t.funJumpers],
  ['pricing',     t.pricing],
  ['gallery',     t.gallery],
  ['faq',         t.faq],
  ['contact',     t.contact],
];

const isActive = (slug) => {
  const target = `/${lang}/${slug}`;
  return path === target || path.startsWith(target + '/');
};
---

<nav class="site-nav" aria-label="Main navigation">
  <div class="site-nav__inner">

    <a href={`/${lang}/`} class="site-nav__logo" aria-label="Skydive Luxembourg home">
      <Image
        src={logoBlack}
        alt=""
        class="site-nav__logo-img site-nav__logo-img--black"
        width={180}
        height={89}
        loading="eager"
      />
      <Image
        src={logoWhite}
        alt=""
        class="site-nav__logo-img site-nav__logo-img--white"
        width={180}
        height={90}
        loading="eager"
      />
    </a>

    <div class="site-nav__menu" id="site-nav-menu" data-nav-list>
      <ul class="site-nav__list">
        {items.map(([slug, label]) => (
          <li>
            <a
              href={`/${lang}/${slug}`}
              class:list={['site-nav__link', { 'is-active': isActive(slug) }]}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
      <LanguageSwitcher />
      <ThemeToggle />
    </div>

    <div class="site-nav__actions">
      <a
        href={bookHref}
        class="btn btn--primary site-nav__book"
      >
        <span class="site-nav__book-full">{t.book}</span>
        <span class="site-nav__book-short">{t.bookShort}</span>
      </a>
    </div>

    <button
      class="site-nav__toggle"
      type="button"
      aria-label={t.menu}
      aria-expanded="false"
      aria-controls="site-nav-menu"
      data-nav-toggle
    >
      <span></span><span></span><span></span>
    </button>

  </div>
</nav>

<script>
  // Mobile menu toggle - vanilla JS, runs on every page load
  const nav = document.querySelector('.site-nav');
  const toggle = document.querySelector('[data-nav-toggle]');
  const list = document.querySelector('[data-nav-list]');

  const syncNavHeight = () => {
    if (!nav) return;
    document.documentElement.style.setProperty('--site-nav-height', `${nav.getBoundingClientRect().height}px`);
  };

  syncNavHeight();
  if ('ResizeObserver' in window && nav) {
    new ResizeObserver(syncNavHeight).observe(nav);
  } else {
    window.addEventListener('resize', syncNavHeight);
  }

  const closeMenu = () => {
    list?.classList.remove('is-open');
    toggle?.setAttribute('aria-expanded', 'false');
  };

  toggle?.addEventListener('click', () => {
    const isOpen = list?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });

  list?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });
</script>

<style>
  .site-nav {
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .site-nav__inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-3) max(var(--space-4), env(safe-area-inset-right)) var(--space-3) max(var(--space-4), env(safe-area-inset-left));
    display: flex;
    align-items: center;
    gap: var(--space-4);
    position: relative;
  }

  .site-nav__logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .site-nav__logo-img {
    display: block;
    width: clamp(140px, 16vw, 190px);
    height: auto;
  }

  .site-nav__logo-img--white { display: none; }

  :global(:root[data-theme="dark"]) .site-nav__logo-img--black { display: none; }
  :global(:root[data-theme="dark"]) .site-nav__logo-img--white { display: block; }

  .site-nav__toggle {
    display: none;
    min-width: 44px;
    min-height: 44px;
    background: none;
    border: 0;
    padding: var(--space-2);
    cursor: pointer;
    flex-direction: column;
    gap: 4px;
  }
  .site-nav__toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-fg);
    transition: var(--transition-fast);
  }

  .site-nav__menu {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-left: auto; /* push nav links + actions to the right on desktop */
  }

  .site-nav__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: var(--space-1);
    flex-wrap: wrap;
  }

  .site-nav__link {
    display: block;
    padding: var(--space-2);
    color: var(--color-fg);
    text-decoration: none;
    border-radius: var(--radius-sm);
    font-weight: var(--fw-medium);
    transition: background var(--transition-fast), color var(--transition-fast);
  }
  .site-nav__link:hover { background: var(--color-bg-alt); }
  .site-nav__link.is-active {
    background: var(--color-blue);
    color: #FFFFFF;
  }

  /* ---------- persistent action: Book a tandem ------------------------- */

  .site-nav__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .site-nav__book {
    padding: var(--space-2) var(--space-4);
    min-height: 44px; /* comfortable touch target, matches the nav toggle */
    font-size: var(--fs-base);
    white-space: nowrap;
  }

  /* Desktop default (nav links visible): keep the Book label compact ("Book")
     so the links + language/theme + button all fit within the 1200px content
     max. The full "Book a tandem" label appears once the links collapse into
     the hamburger (below), where the bar has room to spare. */
  .site-nav__book-full { display: none; }
  .site-nav__book-short { display: inline; }

  /* Tablet & mobile — collapse the nav links into the hamburger. The bar then
     holds only logo + Book + toggle, so we surface the full booking label. */
  @media (max-width: 1180px) {
    .site-nav__toggle { display: flex; }
    .site-nav__actions { margin-left: auto; }
    .site-nav__menu {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      margin-left: 0;
      flex-direction: column;
      align-items: stretch;
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      box-shadow: var(--shadow-md);
      padding: var(--space-4) max(var(--space-4), env(safe-area-inset-right)) max(var(--space-4), env(safe-area-inset-bottom)) max(var(--space-4), env(safe-area-inset-left));
      gap: var(--space-3);
    }
    .site-nav__menu.is-open { display: flex; }
    .site-nav__list {
      flex-direction: column;
      gap: 0;
      width: 100%;
    }
    .site-nav__link { padding: var(--space-3); }

    .site-nav__book-full { display: inline; }
    .site-nav__book-short { display: none; }
  }

  /* Small phones — go back to the short "Book" label and tighten spacing so
     logo + Book + hamburger never crowd the bar. */
  @media (max-width: 560px) {
    .site-nav__inner { gap: var(--space-2); }
    .site-nav__actions { gap: var(--space-1); }
    .site-nav__book { padding: var(--space-2) var(--space-3); }
    .site-nav__logo-img { width: clamp(112px, 34vw, 150px); }

    .site-nav__book-full { display: none; }
    .site-nav__book-short { display: inline; }
  }
</style>
